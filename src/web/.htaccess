# U Čmeláka – Active24 (Apache)
DirectoryIndex index.php
Options -Indexes
RewriteEngine On
RewriteRule ^inc(/|$) - [F,L]
RewriteRule ^index\.html$ / [R=301,L]
RewriteRule ^(menu|objednavka|zahrada|akce|kontakt)\.html$ index.php?s=$1 [L,QSA]
RewriteRule ^sitemap\.xml$ index.php?s=sitemap [L]
RewriteRule ^admin$ admin/ [R=301,L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php?s=404 [L,QSA]

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(webp|jpg|png|svg|woff2)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>
